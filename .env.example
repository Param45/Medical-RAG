# Medical Records RAG Demo — Environment Configuration Template
# Copy this file to .env and supply your deployment values:
# cp .env.example .env

# ==============================================================================
# 1. LLM CONFIGURATION (Single unified settings for all tasks)
# ==============================================================================
# Primary LLM Provider: local, gemini, anthropic, openai
LLM_PROVIDER=local

# Model Identifier
# - For local: medgemma-1.5-4b-it-Q4_K_M.gguf
# - For gemini: gemini-2.5-flash, gemini-1.5-pro, etc.
# - For anthropic: claude-3-5-sonnet-20241022, etc.
# - For openai: gpt-4o, gpt-4o-mini, etc.
LLM_MODEL=medgemma-1.5-4b-it-Q4_K_M.gguf

# API Key for Cloud Provider (Gemini / Anthropic / OpenAI — leave blank for local LLM)
LLM_API_KEY=your_llm_api_key_here

# Local LLM Parameters (used when LLM_PROVIDER=local)
LOCAL_MODEL_PATH=models/medgemma-1.5-4b-it-Q4_K_M.gguf
LOCAL_LLM_N_CTX=8192
LOCAL_LLM_N_THREADS=4

# ==============================================================================
# 2. NEO4J KNOWLEDGE GRAPH CONFIGURATION (Primary Instance: Patient A & B)
# ==============================================================================
# Connection URI for your Neo4j instance (e.g., neo4j+s://xxxxx.databases.neo4j.io)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ==============================================================================
# 3. OCR CONFIGURATION
# ==============================================================================
# OCR Engine: mineru (local PaddleOCR/MinerU) or chandra
OCR_ENGINE=mineru

# API Key for OCR Engine (leave blank for local MinerU)
OCR_API_KEY=
