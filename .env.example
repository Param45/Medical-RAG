# Medical RAG Demo — Configuration
# Copy this file to .env and fill in your real values.
# See SRS §11 for details on each variable.

# --- LLM ---
# Provider name: anthropic, openai, etc.
LLM_PROVIDER=gemini
# Your LLM API key (keep secret, never commit)
LLM_API_KEY=AQ.Ab8RN6I-8pDtk9sLT5PsuKGSlJzLiZYbudj1Nq8MOZqhyHR4jQ
# Model identifier, e.g. claude-sonnet-4-20250514, gpt-4o, etc.
LLM_MODEL=gemini-3.5-flash-lite

# --- OCR ---
# OCR engine to use: mineru (local MinerU) or chandra (Chandra OCR 2, not yet implemented)
OCR_ENGINE=mineru
# API key for the OCR engine (leave blank for MinerU — it runs fully locally)
OCR_API_KEY=

# --- Neo4j (online instance) ---
# Connection URI for your Neo4j instance (e.g., neo4j+s://xxxxx.databases.neo4j.io)
NEO4J_URI=neo4j+s://583d8584.databases.neo4j.io
# Neo4j username (usually "neo4j" for AuraDB)
NEO4J_USERNAME=583d8584
# Neo4j password
NEO4J_PASSWORD=mXDwbCnOouhLKjOhEIYuptbTbW4R9nNeKb_zEfs6S-M